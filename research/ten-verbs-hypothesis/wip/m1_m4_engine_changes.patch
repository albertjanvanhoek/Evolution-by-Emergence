+def channel_loglik(v, a, mask=None):
+    """Log-likelihood of the four behavioural channels, vectorised.
+
+    v: dict with arrays (K,) for take_care, share, repair, find_new_ways.
+    Returns (ll (K,), number of scored terms).
+    """
+    if mask is None:
+        mask = np.ones(T, bool)
+    eps = 1e-9
+    K = len(v["share"])
+    ll = np.zeros(K)
+    n = 0
+    s = np.clip(v["share"], eps, 1 - eps)
+    sel = a["tested"] & mask
+    y = a["shared"][sel]
+    ll += y.sum() * np.log(s) + (~y).sum() * np.log(1 - s)
+    n += int(sel.sum())
+    r = np.clip(v["repair"], eps, 1 - eps)
+    d = a["downs"][mask].sum()
+    at = a["attempts"][mask].sum()
+    ll += at * np.log(r) + (d - at) * np.log(1 - r)
+    n += int(d)
+    m = np.clip(v["find_new_ways"], eps, 1 - eps)
+    k = a["acq_round"]
+    tt = np.arange(T)
+    trials = (tt <= k) if k >= 0 else np.ones(T, bool)
+    succ = (tt == k)
+    ll += (succ & mask).sum() * np.log(m) + ((trials & ~succ) & mask).sum() * np.log(1 - m)
+    n += int((trials & mask).sum())
+    dec = a["decided"] & mask
+    frac = a["budget_frac"][dec]
+    yt = a["tested"][dec]
+    c = np.clip(v["take_care"], 0, 1)
+    p = np.clip(1 - c[:, None] * (1 - frac[None]), eps, 1 - eps)
+    ll += (np.log(p) * yt + np.log(1 - p) * (~yt)).sum(1)
+    n += int(dec.sum())
+    return ll, n
